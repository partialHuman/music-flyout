<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.music-flyout" path="/org/gnome/shell/extensions/music-flyout/">

    <!-- Panel: placement -->
    <key name="panel-position" type="s"><default>'center'</default><summary>Position: far-left, left, center, right or far-right</summary></key>
    <key name="controls-first" type="b"><default>false</default><summary>Show controls before track information</summary></key>
    <key name="hide-when-idle" type="b"><default>true</default><summary>Hide when no media player is running</summary></key>

    <!-- Panel: playback controls -->
    <key name="panel-shuffle" type="b"><default>false</default><summary>Shuffle button in the panel</summary></key>
    <key name="panel-previous" type="b"><default>true</default><summary>Previous track button in the panel</summary></key>
    <key name="panel-skip-back" type="b"><default>false</default><summary>Skip backward button in the panel</summary></key>
    <key name="panel-play-pause" type="b"><default>true</default><summary>Play/pause button in the panel</summary></key>
    <key name="panel-skip-forward" type="b"><default>false</default><summary>Skip forward button in the panel</summary></key>
    <key name="panel-next" type="b"><default>true</default><summary>Next track button in the panel</summary></key>
    <key name="panel-loop" type="b"><default>false</default><summary>Loop button in the panel</summary></key>

    <!-- Panel: track information -->
    <key name="icon-source" type="s"><default>'app-icon'</default><summary>Icon source: app-icon, album-art, playing-status, custom-image or none</summary></key>
    <key name="icon-size" type="i"><range min="8" max="64"/><default>16</default><summary>Icon size (px)</summary></key>
    <key name="icon-spacing" type="i"><range min="0" max="32"/><default>6</default><summary>Space between icon and text (px)</summary></key>
    <key name="custom-icon-path" type="s"><default>''</default><summary>Custom icon image file</summary></key>
    <key name="show-title" type="b"><default>true</default><summary>Show the track title</summary></key>
    <key name="show-artist" type="b"><default>true</default><summary>Show the artist</summary></key>
    <key name="text-width" type="i"><range min="40" max="600"/><default>140</default><summary>Reserved width of the track text (px)</summary></key>

    <!-- Panel: scrolling text -->
    <key name="scroll-text" type="b"><default>true</default><summary>Scroll text that does not fit</summary></key>
    <key name="scroll-repeat" type="b"><default>false</default><summary>Scroll continuously</summary></key>
    <key name="scroll-direction" type="s"><default>'left-to-right'</default><summary>Scroll direction</summary></key>
    <key name="scroll-speed" type="i"><range min="5" max="300"/><default>30</default><summary>Scroll speed (px per second)</summary></key>

    <!-- Panel: scroll wheel controls -->
    <key name="scroll-controls" type="b"><default>true</default><summary>Enable scroll controls on the pill</summary></key>
    <key name="scroll-action" type="s"><default>'change-volume'</default><summary>Scroll action: change-track, change-volume, switch-player or seek</summary></key>
    <key name="volume-scroll-target" type="s"><default>'system'</default><summary>Volume target: system or player</summary></key>
    <key name="invert-scroll-animation" type="b"><default>false</default><summary>Invert the jump animation direction</summary></key>
    <key name="invert-scroll-direction" type="b"><default>false</default><summary>Swap up/down for track and volume actions</summary></key>
    <key name="secondary-scroll" type="b"><default>false</default><summary>Enable the secondary (modifier + scroll) action</summary></key>
    <key name="secondary-scroll-action" type="s"><default>'change-track'</default><summary>Secondary scroll action</summary></key>
    <key name="secondary-scroll-modifier" type="s"><default>'ctrl'</default><summary>Modifier key(s) for the secondary scroll action</summary></key>

    <!-- Panel: mouse buttons and hover -->
    <key name="click-left" type="s"><default>'play-pause'</default><summary>Left click action</summary></key>
    <key name="click-middle" type="s"><default>'none'</default><summary>Middle click action</summary></key>
    <key name="click-right" type="s"><default>'open-card'</default><summary>Right click action</summary></key>
    <key name="hover-open" type="b"><default>false</default><summary>Show the card when hovering the indicator</summary></key>
    <key name="hover-open-delay" type="i"><range min="0" max="3000"/><default>300</default><summary>Hover open delay (ms)</summary></key>
    <key name="hover-close-delay" type="i"><range min="100" max="3000"/><default>400</default><summary>Hover close delay (ms)</summary></key>

    <!-- Panel: visualizer -->
    <key name="show-visualizer" type="b"><default>true</default><summary>Show the visualizer bars</summary></key>
    <key name="bar-count" type="i"><range min="3" max="9"/><default>5</default><summary>Number of visualizer bars</summary></key>
    <key name="use-cava" type="b"><default>true</default><summary>Use cava for a real audio visualizer</summary></key>
    <key name="cava-method" type="s"><default>'pulse'</default><summary>cava input method (pulse or pipewire)</summary></key>

    <!-- Card: appearance -->
    <key name="card-style" type="s"><default>'default'</default><summary>Card style: default or compact</summary></key>
    <key name="card-album-art" type="b"><default>true</default><summary>Show album art in the card</summary></key>
    <key name="album-art-size" type="s"><default>'large'</default><summary>Album art size: small, medium or large</summary></key>
    <key name="card-width" type="i"><range min="280" max="640"/><default>360</default><summary>Card width (px)</summary></key>
    <key name="enable-blur" type="b"><default>true</default><summary>Blur behind the card</summary></key>

    <!-- Card: multiple players -->
    <key name="player-switcher" type="b"><default>true</default><summary>Show the player switcher</summary></key>
    <key name="single-player" type="b"><default>true</default><summary>Pause other players when one starts playing</summary></key>

    <!-- Card: playback -->
    <key name="seek-bar" type="b"><default>true</default><summary>Show the seek bar</summary></key>
    <key name="card-skip-buttons" type="b"><default>true</default><summary>Show skip buttons in the card</summary></key>
    <key name="skip-amount" type="i"><range min="1" max="120"/><default>10</default><summary>Skip amount (seconds)</summary></key>
    <key name="card-shuffle" type="b"><default>true</default><summary>Show the shuffle button in the card</summary></key>
    <key name="card-loop" type="b"><default>true</default><summary>Show the loop button in the card</summary></key>
  </schema>
</schemalist>
